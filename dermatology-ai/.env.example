# Copy to .env (never commit it) and fill in. Every variable the code reads is
# listed here; tests/test_s1_5_repo_hygiene.py enforces that.

# --- storage ----------------------------------------------------------------
# Directory holding derma.db (created 0700, database 0600).
DATA_DIR=./data

# --- model ------------------------------------------------------------------
# Absolute path to a frozen DermatologyCBM state_dict. Unset -> /api/diagnose 503.
MODEL_CHECKPOINT_PATH=
# Optional PPO triage agent. Unset -> triage is reported as unavailable.
AGENT_CHECKPOINT_PATH=
# Manifest used to verify the checkpoint hash (defaults to model_manifest.json).
MODEL_MANIFEST_PATH=
# 1 (default) or 0: apply melanin normalisation in BOTH train and eval pipelines.
MELANIN_NORMALIZATION=1

# --- auth -------------------------------------------------------------------
# Initial admin password. If unset a compliant password is generated and written
# to $DATA_DIR/INITIAL_ADMIN_PASSWORD.txt (mode 0600).
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_EMAIL=
# slowapi limit for the login endpoints.
LOGIN_RATE_LIMIT=5/minute

# --- network ----------------------------------------------------------------
PORT=7860
# Comma-separated CORS allow-list. Never "*".
ALLOWED_ORIGINS=http://localhost:7860
# 1 when behind a reverse proxy, so rate limiting keys on the client IP.
TRUST_PROXY=0

# --- demo -------------------------------------------------------------------
# 1 seeds a synthetic cohort (all records flagged simulated). Never for real use.
DEMO_MODE=0
DEMO_ADMIN_PASSWORD=
DEMO_DOCTOR_PASSWORD=
DERMA_DATA_DIR=./datasets

# --- datasets ---------------------------------------------------------------
# PASSION for Dermatology is access-controlled and unanswered as of 2026-10-30.
# If access is ever granted, the token goes here (never in source); see
# docs/DATASET_CARD_PASSION.md. Leave empty otherwise.
PASSION_TOKEN=
